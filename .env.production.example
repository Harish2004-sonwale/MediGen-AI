# ==============================================================================
# MediGen AI - Production Environment Blueprint (.env.production.example)
# ==============================================================================
# Copy this file to .env or inject as container environment variables in production.
# IMPORTANT: Never commit actual production secrets or passwords to source control.

# Application Environment & Core Settings
PROJECT_NAME="MediGen AI"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=False

# Server & Network Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"
ASGI_WORKERS=4
# Whitelisted production origins (comma-separated, NO wildcards allowed in production)
CORS_ORIGINS="https://app.medigen.ai,https://admin.medigen.ai"

# PostgreSQL Database Configuration (Connection Pooling Hardened)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD@postgres:5432/medigen_ai"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000

# Authentication & JWT Security (Must be strong 64+ char random string)
JWT_SECRET_KEY="CHANGE_ME_GENERATE_STRONG_RANDOM_64_CHAR_SECRET_KEY_FOR_PRODUCTION"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Distributed Redis Caching & Rate Limiting (Phase 9.0.20)
REDIS_URL="redis://:CHANGE_REDIS_PASSWORD@redis:6379/0"
CACHE_ENABLED=True
CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60

# Celery Task Workers & Broker
BACKGROUND_TASK_PROVIDER="celery"
BACKGROUND_TASK_WORKERS=4
CELERY_BROKER_URL="redis://:CHANGE_REDIS_PASSWORD@redis:6379/1"
CELERY_RESULT_BACKEND="redis://:CHANGE_REDIS_PASSWORD@redis:6379/2"

# Pluggable Storage Configuration (local | s3 | mock)
STORAGE_PROVIDER="s3"
S3_BUCKET_NAME="medigen-clinical-assets-prod"
S3_REGION="us-east-1"
S3_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID="CHANGE_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="CHANGE_AWS_SECRET_KEY"

# AI & LLM Providers (Multi-Provider Fallback Chain)
LLM_PROVIDER="bedrock"
FALLBACK_LLM_PROVIDER="openai"
LLM_MODEL="anthropic.claude-3-sonnet-20240229-v1:0"
BEDROCK_MODEL_ID="anthropic.claude-3-sonnet-20240229-v1:0"
OPENAI_API_KEY=""
OPENAI_MODEL_NAME="gpt-4o"
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.65
RAG_MAX_CONTEXT_CHUNKS=8
CHAT_HISTORY_MAX_TURNS=10

# Production Observability & Prometheus Metrics
LOG_LEVEL="INFO"
LOG_FORMAT="json"
PROMETHEUS_METRICS_ENABLED=True

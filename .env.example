# ==============================================================================
# MediGen AI - Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to '.env' in the backend/ directory or root for Docker Compose.
#
# Sections:
# 1. REQUIRED FOR LOCAL DEMO / DEVELOPMENT (Works out-of-the-box with SQLite)
# 2. OPTIONAL FOR PRODUCTION & ADVANCED INTEGRATION (PostgreSQL, Redis, Cloud APIs)
# ==============================================================================

# ==============================================================================
# 1. REQUIRED FOR LOCAL DEMO / DEVELOPMENT
# ==============================================================================

# Application Metadata
PROJECT_NAME="MediGen AI"
VERSION="0.1.0"
ENVIRONMENT="development"  # Options: 'development' | 'staging' | 'production' | 'test'
DEBUG=True

# Core Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"
ASGI_WORKERS=1
CORS_ORIGINS="*"

# Local Database Configuration (Default: SQLite for zero-dependency instant demo)
# For local development with zero external dependencies, keep the SQLite URL:
DATABASE_URL="sqlite:///./medigen_dev.db"

# JWT Authentication Secret (Used for HMAC-SHA256 session token grants)
# In production, this MUST be a cryptographically strong secret >= 32 chars.
JWT_SECRET_KEY="YOUR_DEV_JWT_SECRET_KEY_KEEP_IT_SECRET_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Background Worker Provider (Default: 'local' in-memory threading pool)
# Options: 'local' (zero-dependency) | 'celery' (requires Redis/RabbitMQ)
BACKGROUND_TASK_PROVIDER="local"
BACKGROUND_TASK_WORKERS=4

# Vector Store & Embeddings (Default: 'mock' with ephemeral in-memory ChromaDB)
EMBEDDING_PROVIDER="mock"
EMBEDDING_DIMENSION=384
VECTOR_DB_PATH="data/vector_db"
VECTOR_COLLECTION_NAME="medical_documents"

# Clinical LLM Provider (Default: 'mock' for offline deterministic demo responses)
# Options: 'mock' | 'openai' | 'anthropic' | 'gemini'
LLM_PROVIDER="mock"
LLM_MODEL="medigen-clinical-v1"
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.0
RAG_MAX_CONTEXT_CHUNKS=10
CHAT_HISTORY_MAX_TURNS=5

# Document & Storage Paths
DOCUMENT_STORAGE_PATH="data/medical_documents"
MAX_DOCUMENT_SIZE_MB=10

# Pluggable Clinical Knowledge Providers (Default: 'mock')
DRUG_KNOWLEDGE_PROVIDER="mock"
OCR_ENABLED=False
OCR_PROVIDER="mock"

# Production Observability & Logging
LOG_LEVEL="INFO"
LOG_FORMAT="text"  # Options: 'text' (human-readable) | 'json' (structured)
METRICS_ENABLED=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60


# ==============================================================================
# 2. OPTIONAL FOR PRODUCTION & ADVANCED INTEGRATIONS
# ==============================================================================

# Production PostgreSQL Database
# DATABASE_URL="postgresql+psycopg://medigen_user:STRONG_PASSWORD_HERE@localhost:5432/medigen_ai"
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=5

# Production Redis Distributed Cache & WebSocket Backplane
# REDIS_URL="redis://:REDIS_PASSWORD@localhost:6379/0"
# CELERY_BROKER_URL="redis://:REDIS_PASSWORD@localhost:6379/1"
# CELERY_RESULT_BACKEND="redis://:REDIS_PASSWORD@localhost:6379/2"

# External Cloud LLM & Vision API Keys (Required only if LLM_PROVIDER is not 'mock')
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=


# Speech-to-Text / Audio Transcription Provider (for AI Medical Scribe)
# SPEECH_PROVIDER="mock"  # Options: 'mock' | 'whisper' | 'google'
# OPENAI_WHISPER_API_KEY=""

# S3 / MinIO Object Storage (Optional: replaces local file storage)
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="medigen-medical-storage"
# S3_REGION="us-east-1"

# Production Alert Email / SMTP Notifications
# SMTP_HOST="smtp.hospital.org"
# SMTP_PORT=587
# SMTP_USER="alerts@hospital.org"
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="medigen-alerts@hospital.org"

# Hospital PACS / DICOM Gateway Integration (Optional: connects to live Orthanc / DCM4CHEE)
# DICOM_PACS_AET="MEDIGEN_PACS"
# DICOM_PACS_HOST="pacs.hospital.org"
# DICOM_PACS_PORT=11112
# DICOM_WADO_BASE_URL="http://pacs.hospital.org:8042/dicom-web"

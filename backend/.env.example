# Application Configuration
PROJECT_NAME="MediGen AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/medigen_ai"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# JWT & Authentication Configuration
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vector Database & Embedding Configuration (Phase 8.4)
EMBEDDING_PROVIDER="mock"
EMBEDDING_DIMENSION=384
VECTOR_DB_PATH="data/vector_db"
VECTOR_COLLECTION_NAME="medical_documents"

# Clinical RAG & LLM Configuration (Phase 8.5, 8.6 & 8.8)
LLM_PROVIDER="mock"
LLM_MODEL="medigen-clinical-v1"
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.0
RAG_MAX_CONTEXT_CHUNKS=10
CHAT_HISTORY_MAX_TURNS=5
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
ANTHROPIC_API_KEY=""

# Pluggable OCR Configuration (Phase 8.8)
OCR_ENABLED=False
OCR_PROVIDER="mock"

# AWS & Bedrock Configuration (Phase 8.8)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# Drug Knowledge Base Configuration (Phase 9.0.2)
# Options: 'mock' (offline, default — no credentials required)
#          'openfda' (uses public FDA openFDA API — optional API key increases rate limits)
# Default is 'mock' so the system works fully offline without any credentials.
DRUG_KNOWLEDGE_PROVIDER="mock"
# OPENFDA_API_KEY=""         # Optional — leave blank to use anonymous rate limits
# OPENFDA_TIMEOUT_SECONDS=5  # HTTP timeout for openFDA requests

# Background Asynchronous Worker Configuration (Phase 9.0.3)
# Options: 'local' (offline thread pool, default — no Redis required)
#          'sync' (synchronous inline execution for debugging)
#          'celery' (distributed Celery worker with Redis broker)
BACKGROUND_TASK_PROVIDER="local"
BACKGROUND_TASK_WORKERS=4
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Production Observability & Monitoring Configuration (Phase 9.0.4)
LOG_LEVEL="INFO"
LOG_FORMAT="text"
METRICS_ENABLED=True
